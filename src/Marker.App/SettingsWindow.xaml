<Window
    x:Class="Marker.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Marker.App"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="Marker 设置">
    <Grid x:Name="SettingsRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default"><StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="ApplicationPageBackgroundThemeBrush" /></ResourceDictionary>
                    <ResourceDictionary x:Key="Light"><StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="ApplicationPageBackgroundThemeBrush" /></ResourceDictionary>
                    <ResourceDictionary x:Key="Dark"><StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="ApplicationPageBackgroundThemeBrush" /></ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast"><StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="ApplicationPageBackgroundThemeBrush" /></ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="SettingsCombo" TargetType="ComboBox">
                    <Setter Property="Width" Value="244" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="primitives:ComboBoxHelper.KeepInteriorCornersSquare" Value="False" />
                    <Setter Property="Padding" Value="10,0" />
                </Style>
                <Style x:Key="SettingsNumber" TargetType="NumberBox">
                    <Setter Property="Width" Value="244" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="10,8,10,8" />
                </Style>
                <Style x:Key="SectionCard" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="14" />
                    <Setter Property="Padding" Value="18,14" />
                </Style>
                <Style x:Key="RowSeparator" TargetType="Border">
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Padding" Value="0,0,0,6" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch">
                <Border MaxWidth="680" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Stretch" Padding="26,22,26,30" Spacing="14">
                        <Grid ColumnSpacing="14" Margin="2,0,2,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="AccentMark" Width="44" Height="44" CornerRadius="13" Background="#7665A8" VerticalAlignment="Center">
                                <FontIcon x:Name="AccentIcon" Glyph="&#xE713;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock TextWrapping="Wrap" Text="设置" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap" Text="按你的写作习惯调整 Marker" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock TextWrapping="Wrap" Text="外观与行为" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Text="选择应用配色并设置编辑行为" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Style="{StaticResource RowSeparator}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="主题"/><TextBlock TextWrapping="Wrap" Text="跟随 Windows 或固定明暗模式" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                        <local:SettingsComboBox x:Name="ThemeCombo" AutomationProperties.Name="主题" Grid.Column="1" Style="{StaticResource SettingsCombo}" AutomationProperties.AutomationId="Theme" SelectionChanged="Theme_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/>
                                        </local:SettingsComboBox>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource RowSeparator}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="颜色组合"/><TextBlock TextWrapping="Wrap" Text="更改文档画布与强调色" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                        <local:SettingsComboBox x:Name="ColorPaletteCombo" AutomationProperties.Name="颜色组合" Grid.Column="1" Style="{StaticResource SettingsCombo}" AutomationProperties.AutomationId="ColorPalette" SelectionChanged="ColorPalette_SelectionChanged">
                                            <ComboBoxItem Tag="lavender"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse Width="14" Height="14" Fill="#7665A8"/><TextBlock TextWrapping="Wrap" Text="薰衣草" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                                            <ComboBoxItem Tag="forest"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse Width="14" Height="14" Fill="#3D7656"/><TextBlock TextWrapping="Wrap" Text="森林" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                                            <ComboBoxItem Tag="ocean"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse Width="14" Height="14" Fill="#347493"/><TextBlock TextWrapping="Wrap" Text="海洋" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                                            <ComboBoxItem Tag="paper"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse Width="14" Height="14" Fill="#986D38"/><TextBlock TextWrapping="Wrap" Text="纸张" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                                            <ComboBoxItem Tag="graphite"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse Width="14" Height="14" Fill="#596B79"/><TextBlock TextWrapping="Wrap" Text="石墨" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                                        </local:SettingsComboBox>
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="自动折行"/><TextBlock TextWrapping="Wrap" Text="长行在编辑区内换行显示" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                    <ToggleSwitch x:Name="LineWrappingToggle" AutomationProperties.Name="自动折行" Grid.Column="1" Width="120" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="开" OffContent="关" AutomationProperties.AutomationId="LineWrapping" Toggled="LineWrapping_Toggled" />
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}" />
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="减少动画"/><TextBlock TextWrapping="Wrap" Text="同时遵循 Windows 动画偏好" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                    <ToggleSwitch x:Name="ReducedMotionToggle" AutomationProperties.Name="减少动画" Grid.Column="1" Width="120" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="开" OffContent="关" AutomationProperties.AutomationId="ReducedMotion" Toggled="ReducedMotion_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock TextWrapping="Wrap" Text="阅读节奏" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Text="微调正文字号与段落留白" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Style="{StaticResource RowSeparator}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="正文字号"/><TextBlock TextWrapping="Wrap" Text="12–24 px" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                        <NumberBox x:Name="FontSizeBox" AutomationProperties.Name="正文字号" Grid.Column="1" Style="{StaticResource SettingsNumber}" Minimum="12" Maximum="24" SmallChange="1" Value="16" SpinButtonPlacementMode="Hidden" UseSystemFocusVisuals="True" AutomationProperties.AutomationId="FontSize" ValueChanged="FontSize_ValueChanged"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource RowSeparator}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="行间距"/><TextBlock TextWrapping="Wrap" Text="正文行高倍数，1.2–2.0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                        <NumberBox x:Name="LineHeightBox" AutomationProperties.Name="行间距" Grid.Column="1" Style="{StaticResource SettingsNumber}" Minimum="1.2" Maximum="2" SmallChange="0.1" Value="1.5" SpinButtonPlacementMode="Hidden" UseSystemFocusVisuals="True" AutomationProperties.AutomationId="LineHeight" ValueChanged="LineHeight_ValueChanged"/>
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="段间距"/><TextBlock Text="在 Markdown 分段空行基础上追加，单位为正文字号" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                    <NumberBox x:Name="ParagraphSpacingBox" AutomationProperties.Name="段间距" Grid.Column="1" Style="{StaticResource SettingsNumber}" Minimum="0" Maximum="2" SmallChange="0.1" Value="0.5" SpinButtonPlacementMode="Hidden" UseSystemFocusVisuals="True" AutomationProperties.AutomationId="ParagraphSpacing" ValueChanged="ParagraphSpacing_ValueChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock TextWrapping="Wrap" Text="字体" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Text="选用系统已安装的常见中文字体" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Style="{StaticResource RowSeparator}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="正文字体"/><TextBlock TextWrapping="Wrap" Text="用于段落、列表与表格" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                        <local:SettingsComboBox x:Name="BodyFontCombo" AutomationProperties.Name="正文字体" Grid.Column="1" Style="{StaticResource SettingsCombo}" AutomationProperties.AutomationId="BodyFont" SelectionChanged="BodyFont_SelectionChanged">
                                            <ComboBoxItem Content="系统默认" Tag="system"/><ComboBoxItem Content="宋体" Tag="song"/><ComboBoxItem Content="微软雅黑" Tag="yahei"/><ComboBoxItem Content="等线" Tag="dengxian"/><ComboBoxItem Content="衬线字体" Tag="serif"/>
                                        </local:SettingsComboBox>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource RowSeparator}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="H1 字体"/><TextBlock TextWrapping="Wrap" Text="一级标题" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                        <local:SettingsComboBox x:Name="H1FontCombo" AutomationProperties.Name="H1 字体" Grid.Column="1" Style="{StaticResource SettingsCombo}" AutomationProperties.AutomationId="H1Font" SelectionChanged="H1Font_SelectionChanged">
                                            <ComboBoxItem Content="系统默认" Tag="system"/><ComboBoxItem Content="宋体" Tag="song"/><ComboBoxItem Content="微软雅黑" Tag="yahei"/><ComboBoxItem Content="等线" Tag="dengxian"/><ComboBoxItem Content="衬线字体" Tag="serif"/>
                                        </local:SettingsComboBox>
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock TextWrapping="Wrap" Text="H2 字体"/><TextBlock TextWrapping="Wrap" Text="二级标题" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                    <local:SettingsComboBox x:Name="H2FontCombo" AutomationProperties.Name="H2 字体" Grid.Column="1" Style="{StaticResource SettingsCombo}" AutomationProperties.AutomationId="H2Font" SelectionChanged="H2Font_SelectionChanged">
                                        <ComboBoxItem Content="系统默认" Tag="system"/><ComboBoxItem Content="宋体" Tag="song"/><ComboBoxItem Content="微软雅黑" Tag="yahei"/><ComboBoxItem Content="等线" Tag="dengxian"/><ComboBoxItem Content="衬线字体" Tag="serif"/>
                                    </local:SettingsComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="顶部栏" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="选择要直接显示的功能；隐藏的功能仍可从“更多”菜单使用。设置入口始终保留。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Grid x:Name="ToolbarActionsPanel" ColumnSpacing="12" RowSpacing="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <CheckBox Content="新建" Tag="new" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="打开" Tag="open" Grid.Column="1" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="保存" Tag="save" Grid.Row="1" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="另存为" Tag="saveAs" Grid.Row="1" Grid.Column="1" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="恢复草稿" Tag="recover" Grid.Row="2" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="撤销" Tag="undo" Grid.Row="2" Grid.Column="1" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="重做" Tag="redo" Grid.Row="3" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="查找" Tag="find" Grid.Row="3" Grid.Column="1" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="替换" Tag="replace" Grid.Row="4" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="代码模式" Tag="toggleSource" Grid.Row="4" Grid.Column="1" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                    <CheckBox Content="字数统计" Tag="statistics" Grid.Row="5" Checked="ToolbarAction_Toggled" Unchecked="ToolbarAction_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NoticePanel" Visibility="Collapsed" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock x:Name="SettingsNotice" Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
