<UserControl
    x:Class="Marker.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Padding="12" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <Button Content="新建" AutomationProperties.AutomationId="NewDocument" Click="NewDocument_Click" />
            <Button Content="打开" AutomationProperties.AutomationId="OpenDocument" Click="OpenDocument_Click" />
            <Button Content="保存" AutomationProperties.AutomationId="SaveDocument" Click="SaveDocument_Click" />
            <Button Content="另存为" AutomationProperties.AutomationId="SaveAsDocument" Click="SaveAsDocument_Click" />
            <Button Content="恢复草稿" AutomationProperties.AutomationId="RecoverDocument" Click="RecoverDocument_Click" />
            <TextBlock x:Name="DocumentStatus" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="DocumentStatus" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
            <ComboBox x:Name="ViewModeCombo" Header="视图" Width="148" AutomationProperties.AutomationId="ViewMode" SelectionChanged="ViewMode_SelectionChanged">
                <x:String>源码</x:String>
                <x:String>分栏</x:String>
                <x:String>阅读</x:String>
            </ComboBox>
            <Button x:Name="EditorFocusButton" VerticalAlignment="Bottom" Click="EditorFocusButton_Click" Content="进入编辑器" />
            <Button x:Name="ResyncButton" VerticalAlignment="Bottom" Click="ResyncButton_Click" Content="重新同步" />
            <TextBlock x:Name="SettingsNotice" Width="280" MaxHeight="32" VerticalAlignment="Bottom" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
            <Button Content="撤销" AutomationProperties.AutomationId="Undo" Click="Undo_Click" />
            <Button Content="重做" AutomationProperties.AutomationId="Redo" Click="Redo_Click" />
            <Button Content="查找" AutomationProperties.AutomationId="Find" Click="Find_Click" />
            <Button Content="替换" AutomationProperties.AutomationId="Replace" Click="Replace_Click" />
            <TextBlock x:Name="EditorSelectionStatus" VerticalAlignment="Center" AutomationProperties.AutomationId="EditorSelectionStatus" Text="行 1，列 1" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="ThemeCombo" Header="主题" Width="132" AutomationProperties.AutomationId="Theme" SelectionChanged="Theme_SelectionChanged">
                <x:String>跟随系统</x:String>
                <x:String>浅色</x:String>
                <x:String>深色</x:String>
            </ComboBox>
            <NumberBox x:Name="FontSizeBox" Header="字号" Width="88" Minimum="12" Maximum="24" SmallChange="1" Value="16" SpinButtonPlacementMode="Inline" AutomationProperties.AutomationId="FontSize" ValueChanged="FontSize_ValueChanged" />
            <NumberBox x:Name="LineHeightBox" Header="行高" Width="92" Minimum="1.2" Maximum="2" SmallChange="0.1" Value="1.5" SpinButtonPlacementMode="Inline" AutomationProperties.AutomationId="LineHeight" ValueChanged="LineHeight_ValueChanged" />
            <ToggleButton x:Name="LineWrappingToggle" Content="自动换行" IsChecked="True" VerticalAlignment="Bottom" AutomationProperties.AutomationId="LineWrapping" Click="LineWrapping_Click" />
        </StackPanel>
        <TextBlock
            x:Name="BridgeStatus"
            Grid.Row="4"
            AutomationProperties.AutomationId="BridgeStatus"
            IsHitTestVisible="False"
            Text="正在初始化 WebView2…" />
    </Grid>
</UserControl>
