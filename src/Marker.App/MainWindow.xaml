<UserControl
    x:Class="Marker.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Shell_Loaded" KeyDown="Shell_KeyDown" AllowDrop="True" DragOver="Shell_DragOver" Drop="Shell_Drop">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="MarkerBrandBrush" Color="#7665A8"/><SolidColorBrush x:Key="MarkerBrandTextBrush" Color="White"/></ResourceDictionary>
                <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="MarkerBrandBrush" Color="#7665A8"/><SolidColorBrush x:Key="MarkerBrandTextBrush" Color="White"/></ResourceDictionary>
                <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="MarkerBrandBrush" Color="#B6A5DF"/><SolidColorBrush x:Key="MarkerBrandTextBrush" Color="#211F27"/></ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="MarkerBrandBrush" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="MarkerBrandTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Padding="16,10,16,10" RowSpacing="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="ToolbarShadowReceiver" />
        <Border x:Name="ToolbarGlass" CornerRadius="18" BorderThickness="1" Padding="12,10">
        <Grid x:Name="CommandRow" Height="40" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="280"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid x:Name="BrandPanel" ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid x:Name="DocumentRow">
                    <TextBlock x:Name="DocumentStatus" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=DocumentStatus}" AutomationProperties.AutomationId="DocumentStatus"/>
                </Grid>
            </Grid>
            <CommandBar x:Name="DocumentCommandBar" Grid.Column="1" Height="40" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                <CommandBar.Resources>
                    <x:Double x:Key="AppBarButtonContentHeight">14</x:Double>
                    <x:Double x:Key="AppBarThemeMinHeight">36</x:Double>
                    <x:Double x:Key="AppBarThemeCompactHeight">36</x:Double>
                    <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,10,0,10</Thickness>
                    <Thickness x:Key="AppBarButtonContentViewboxCompactMargin">0,10,0,10</Thickness>
                    <Thickness x:Key="AppBarButtonContentViewboxMargin">10,10,0,10</Thickness>
                    <Thickness x:Key="AppBarButtonTextLabelOnRightMargin">6,8,8,8</Thickness>
                    <Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">6,8,8,8</Thickness>
                    <Thickness x:Key="CommandBarMoreButtonMargin">8,8,8,0</Thickness>
                </CommandBar.Resources>
                <CommandBar.PrimaryCommands>
                    <AppBarButton Width="40" x:Name="NewButton" Label="新建" LabelPosition="Collapsed" AutomationProperties.Name="新建文档" AutomationProperties.AutomationId="NewDocument" ToolTipService.ToolTip="新建文档 · Ctrl+N" Click="NewDocument_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8A5;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Width="40" x:Name="OpenButton" Label="打开" LabelPosition="Collapsed" AutomationProperties.Name="打开" AutomationProperties.AutomationId="OpenDocument" ToolTipService.ToolTip="打开 · Ctrl+O" Click="OpenDocument_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8E5;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Width="40" x:Name="SaveButton" Label="保存" LabelPosition="Collapsed" AutomationProperties.Name="保存" AutomationProperties.AutomationId="SaveDocument" ToolTipService.ToolTip="保存 · Ctrl+S" Click="SaveDocument_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarToggleButton Width="40" x:Name="SourceModeButton" Label="代码模式" LabelPosition="Collapsed" AutomationProperties.Name="代码模式" AutomationProperties.AutomationId="SourceMode" ToolTipService.ToolTip="代码模式 · Ctrl+Alt+M" Click="SourceMode_Click"><AppBarToggleButton.Icon><FontIcon Glyph="&#xE943;"/></AppBarToggleButton.Icon></AppBarToggleButton>
                    <AppBarButton Width="40" x:Name="SaveAsButton" Label="另存为" LabelPosition="Collapsed" AutomationProperties.Name="另存为" AutomationProperties.AutomationId="SaveAsDocument" ToolTipService.ToolTip="另存为 · Ctrl+Shift+S" Click="SaveAsDocument_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE792;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Width="40" x:Name="RecoverButton" Label="恢复草稿" LabelPosition="Collapsed" AutomationProperties.Name="恢复草稿" AutomationProperties.AutomationId="RecoverDocument" ToolTipService.ToolTip="恢复草稿" Click="RecoverDocument_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE81C;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Width="40" x:Name="UndoButton" Label="撤销" LabelPosition="Collapsed" AutomationProperties.Name="撤销" AutomationProperties.AutomationId="Undo" ToolTipService.ToolTip="撤销 · Ctrl+Z" Click="Undo_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE7A7;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Width="40" x:Name="RedoButton" Label="重做" LabelPosition="Collapsed" AutomationProperties.Name="重做" AutomationProperties.AutomationId="Redo" ToolTipService.ToolTip="重做 · Ctrl+Y" Click="Redo_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE7A6;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Width="40" x:Name="FindButton" Label="查找" LabelPosition="Collapsed" AutomationProperties.Name="查找" AutomationProperties.AutomationId="Find" ToolTipService.ToolTip="查找 · Ctrl+F" Click="Find_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE721;"/></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Width="40" x:Name="ReplaceButton" Label="替换" LabelPosition="Collapsed" AutomationProperties.Name="替换" AutomationProperties.AutomationId="Replace" ToolTipService.ToolTip="替换 · Ctrl+H" Click="Replace_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8AC;"/></AppBarButton.Icon></AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Width="32" Height="32" Source="ms-appx:///Assets/AppLogo.png" Stretch="Uniform" AutomationProperties.Name="Marker 标志" />
                <Button x:Name="AppearanceButton" Style="{StaticResource QuietButton}" Width="40" Height="36" Padding="0" AutomationProperties.Name="设置" AutomationProperties.AutomationId="Appearance" ToolTipService.ToolTip="设置" Click="Appearance_Click"><FontIcon Glyph="&#xE713;" FontSize="14"/></Button>
            </StackPanel>
        </Grid>
        </Border>
        <TextBlock x:Name="NotificationStatus" Grid.Row="2" Visibility="Collapsed" MaxHeight="28" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
