<UserControl
    x:Class="Marker.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Shell_Loaded" KeyDown="Shell_KeyDown" AllowDrop="True" DragOver="Shell_DragOver" Drop="Shell_Drop">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="MarkerBrandBrush" Color="#7665A8"/><SolidColorBrush x:Key="MarkerBrandTextBrush" Color="White"/></ResourceDictionary>
                <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="MarkerBrandBrush" Color="#7665A8"/><SolidColorBrush x:Key="MarkerBrandTextBrush" Color="White"/></ResourceDictionary>
                <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="MarkerBrandBrush" Color="#B6A5DF"/><SolidColorBrush x:Key="MarkerBrandTextBrush" Color="#211F27"/></ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="MarkerBrandBrush" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="MarkerBrandTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style x:Key="QuietToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Padding="20,12,20,8" RowSpacing="4" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="CommandRow" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource MarkerBrandBrush}">
                    <FontIcon Glyph="&#xE8A5;" FontSize="17" Foreground="{ThemeResource MarkerBrandTextBrush}" />
                </Border>
                <TextBlock Text="Marker" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="NewButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="新建文档" AutomationProperties.AutomationId="NewDocument" ToolTipService.ToolTip="新建文档 · Ctrl+N" Click="NewDocument_Click"><FontIcon Glyph="&#xE8A5;" FontSize="16"/></Button>
                <Button x:Name="OpenButton" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="OpenDocument" ToolTipService.ToolTip="打开 · Ctrl+O" Click="OpenDocument_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8E5;" FontSize="16"/><TextBlock Text="打开"/></StackPanel></Button>
                <Button x:Name="SaveButton" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="SaveDocument" ToolTipService.ToolTip="保存 · Ctrl+S" Click="SaveDocument_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74E;" FontSize="16"/><TextBlock Text="保存"/></StackPanel></Button>
                <Button Style="{StaticResource QuietButton}" AutomationProperties.Name="另存为" AutomationProperties.AutomationId="SaveAsDocument" ToolTipService.ToolTip="另存为 · Ctrl+Shift+S" Click="SaveAsDocument_Click"><FontIcon Glyph="&#xE792;" FontSize="16"/></Button>
                <Button Style="{StaticResource QuietButton}" AutomationProperties.Name="恢复草稿" AutomationProperties.AutomationId="RecoverDocument" ToolTipService.ToolTip="恢复草稿" Click="RecoverDocument_Click"><FontIcon Glyph="&#xE81C;" FontSize="16"/></Button>
                <Button x:Name="MoreButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="更多文档操作" AutomationProperties.AutomationId="DocumentMenu" ToolTipService.ToolTip="更多文档操作">
                    <FontIcon Glyph="&#xE712;" FontSize="16"/>
                    <Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="EditorFocusButton" Text="进入编辑器" Click="EditorFocusButton_Click"/><MenuFlyoutItem x:Name="ResyncButton" Text="重新同步预览" Click="ResyncButton_Click"/></MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ComboBox x:Name="ViewModeCombo" Width="116" Height="34" AutomationProperties.Name="视图模式" AutomationProperties.AutomationId="ViewMode" SelectionChanged="ViewMode_SelectionChanged"><x:String>源码</x:String><x:String>分栏</x:String><x:String>阅读</x:String></ComboBox>
                <ToggleButton x:Name="AppearanceButton" Style="{StaticResource QuietToggle}" AutomationProperties.Name="外观与排版" AutomationProperties.AutomationId="Appearance" ToolTipService.ToolTip="外观与排版" Click="Appearance_Click"><FontIcon Glyph="&#xE713;" FontSize="16"/></ToggleButton>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="DocumentRow">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="DocumentStatus" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="DocumentStatus"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button x:Name="UndoButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="撤销" AutomationProperties.AutomationId="Undo" ToolTipService.ToolTip="撤销 · Ctrl+Z" Click="Undo_Click"><FontIcon Glyph="&#xE7A7;" FontSize="15"/></Button>
                <Button x:Name="RedoButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="重做" AutomationProperties.AutomationId="Redo" ToolTipService.ToolTip="重做 · Ctrl+Y" Click="Redo_Click"><FontIcon Glyph="&#xE7A6;" FontSize="15"/></Button>
                <Button x:Name="FindButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="查找" AutomationProperties.AutomationId="Find" ToolTipService.ToolTip="查找 · Ctrl+F" Click="Find_Click"><FontIcon Glyph="&#xE721;" FontSize="15"/></Button>
                <Button x:Name="ReplaceButton" Style="{StaticResource QuietButton}" AutomationProperties.Name="替换" AutomationProperties.AutomationId="Replace" ToolTipService.ToolTip="替换 · Ctrl+H" Click="Replace_Click"><FontIcon Glyph="&#xE8AC;" FontSize="15"/></Button>
            </StackPanel>
        </Grid>
        <Border x:Name="AppearancePanel" Grid.Row="2" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="9" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="ThemeCombo" Header="主题" Width="128" AutomationProperties.AutomationId="Theme" SelectionChanged="Theme_SelectionChanged"><x:String>跟随系统</x:String><x:String>浅色</x:String><x:String>深色</x:String></ComboBox>
                <NumberBox x:Name="FontSizeBox" Header="字号" Width="88" Minimum="12" Maximum="24" SmallChange="1" Value="16" SpinButtonPlacementMode="Inline" AutomationProperties.AutomationId="FontSize" ValueChanged="FontSize_ValueChanged"/>
                <NumberBox x:Name="LineHeightBox" Header="行高" Width="92" Minimum="1.2" Maximum="2" SmallChange="0.1" Value="1.5" SpinButtonPlacementMode="Inline" AutomationProperties.AutomationId="LineHeight" ValueChanged="LineHeight_ValueChanged"/>
                <ToggleButton x:Name="LineWrappingToggle" Content="自动折行" IsChecked="True" VerticalAlignment="Bottom" AutomationProperties.AutomationId="LineWrapping" Click="LineWrapping_Click"/>
                <ToggleButton x:Name="ReducedMotionToggle" Content="减少动画" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ReducedMotion" Click="ReducedMotion_Click"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="BridgeStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="BridgeStatus" Text="正在准备写作空间…" />
            <TextBlock x:Name="EditorSelectionStatus" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="EditorSelectionStatus" Text="行 1，列 1"/>
        </Grid>
        <TextBlock x:Name="SettingsNotice" Grid.Row="4" Visibility="Collapsed" MaxHeight="32" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
